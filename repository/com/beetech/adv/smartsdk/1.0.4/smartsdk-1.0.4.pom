<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.beetech.adv</groupId>
    <artifactId>smartsdk</artifactId>
    <version>1.0.4</version>
    <packaging>jar</packaging>

    <name>Beetech Adv.SmartSdk Java Binding</name>
    <description>Universal RFID SmartSdk Java 21+ Project Panama (FFM) unmanaged binding with embedded cross-platform Native AOT engines (Windows, Linux, macOS).</description>
    <url>https://github.com/anhdovan/Adv.SmartSdk</url>

    <licenses>
        <license>
            <name>Proprietary / Commercial</name>
            <url>https://beetech-autoid.com/license</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>beetech</id>
            <name>Beetech AutoID Corp.</name>
            <email>support@beetech-autoid.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/anhdovan/Adv.SmartSdk.git</connection>
        <developerConnection>scm:git:ssh://github.com:anhdovan/Adv.SmartSdk.git</developerConnection>
        <url>https://github.com/anhdovan/Adv.SmartSdk</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>runtimes/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
